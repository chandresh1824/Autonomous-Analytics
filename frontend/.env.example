# Backend API base URL (defaults to http://localhost:8000 when unset).
VITE_API_BASE_URL=http://localhost:8000

# --- Microsoft Entra ID (Azure AD) sign-in -----------------------------------
# The app is locked until these are set: hitting any URL while signed out
# redirects straight to Microsoft.
#
# Register a SPA application in Entra ID and add the redirect URI below under
# "Single-page application" (NOT "Web") - the SPA flow is authorization code
# with PKCE and has no client secret.
VITE_AZURE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_AZURE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Optional: defaults to https://login.microsoftonline.com/<tenant id>
VITE_AZURE_ENTRA_AUTHORITY=https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000
# Must match a redirect URI registered on the app, exactly.
VITE_AZURE_ENTRA_REDIRECT_URI=http://localhost:5173

# Optional: scope exposed by the backend's own app registration, e.g.
# api://<api-client-id>/access_as_user. Set this once the backend validates
# bearer tokens; until then the UI signs in without requesting an API token.
# VITE_AZURE_ENTRA_API_SCOPE=
