FROM node:20-slim AS build
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
ARG VITE_API_BASE_URL=http://localhost:8000
ARG VITE_AZURE_ENTRA_TENANT_ID
ARG VITE_AZURE_ENTRA_CLIENT_ID
ARG VITE_AZURE_ENTRA_AUTHORITY
ARG VITE_AZURE_ENTRA_REDIRECT_URI
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL \
    VITE_AZURE_ENTRA_TENANT_ID=$VITE_AZURE_ENTRA_TENANT_ID \
    VITE_AZURE_ENTRA_CLIENT_ID=$VITE_AZURE_ENTRA_CLIENT_ID \
    VITE_AZURE_ENTRA_AUTHORITY=$VITE_AZURE_ENTRA_AUTHORITY \
    VITE_AZURE_ENTRA_REDIRECT_URI=$VITE_AZURE_ENTRA_REDIRECT_URI
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
