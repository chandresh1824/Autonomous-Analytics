APP_ENV=development
LOG_LEVEL=INFO

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

FRONTEND_URL=http://localhost:5173

# LLM_PROVIDER selects which backing LLM DeepAgent uses: "lmstudio" (default,
# local) or "azure_openai" (recommended if your local LM Studio model doesn't
# reliably support tool/function calling - see README's Azure OpenAI section).
LLM_PROVIDER=lmstudio

LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=lm-studio
LM_STUDIO_MODEL=
LM_STUDIO_EMBEDDING_MODEL=

# Separate model for semantic-model generation (draft, relationship and
# synonym suggestions) and the chat planner, on the same LLM_PROVIDER: a model
# name for lmstudio, a deployment name for azure_openai. Leave empty to use
# the main chat model for these too.
SEMANTIC_PLANNER_MODEL=microsoft/phi-4-mini-reasoning

# Separate model for the DeepAgent tool-calling orchestrator (must support
# native tool/function calling). Leave empty to use the main chat model.
TOOL_CALLING_MODEL=qwen3loop-0.6b-tool-calling-sft-v1

# Separate model for the SQL Agent and SQL Repair Agent (SQL generation and
# fixing SQL that failed validation). Leave empty to use the main chat model.
SQL_AGENT_MODEL=qwen/qwen3-4b-2507

# How many selected tables semantic-model generation drafts in parallel. Keep 1
# for a single local LM Studio (parallel requests share its throughput and hit
# the 90s timeout); use 3-4 for a server that serves concurrent requests
# (Azure OpenAI, vLLM, or LM Studio with "Max Concurrent Predictions" raised).
SEMANTIC_GENERATION_CONCURRENCY=1

# Columns of one table classified per LLM call during semantic-model generation.
# Smaller batches mean shorter answers that finish inside LLM_TIMEOUT_SECONDS;
# wide tables are split into several calls.
SEMANTIC_GENERATION_BATCH_SIZE=6

# Client timeout (seconds) for every LLM request.
LLM_TIMEOUT_SECONDS=180

# Only used when LLM_PROVIDER=azure_openai. Deployment names, not model names.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Application metadata store (connections, semantic model versions,
# conversations/messages, pinned widgets) - a MySQL database, Amazon RDS in
# production. Create the database itself once (CREATE DATABASE ...); the app
# creates its tables automatically on first startup and no-ops after that.
# This is NOT a business datasource: the databases you ask questions about
# are added at runtime in Settings and stored in the `connections` table.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# TLS is always on, using mysql2's bundled Amazon RDS CA chain - there is no
# cert file to ship and no opt-out, so the metadata connection can never
# silently fall back to plaintext.

VECTOR_STORE_PATH=./data/vector_store

MAX_QUERY_ROWS=1000
QUERY_TIMEOUT_SECONDS=30
MAX_SQL_REPAIR_ATTEMPTS=2

# RAG retrieval tuning - see services/rag and services/semantic/resolver.ts
# for what each one controls. Safe to leave at these defaults.
RAG_SCORE_THRESHOLD=0.32
RAG_LEXICAL_WEIGHT=0.25
RAG_OVERSAMPLE_FACTOR=4
CONNECTION_ROUTING_SCORE_THRESHOLD=0.45
# When two databases' routing scores are within this margin, the planner
# model picks between them from their catalogs (adds one LLM call). 0 = never.
CONNECTION_ROUTING_MARGIN=0.08
KPI_PREFERENCE_MARGIN=-0.05

# Microsoft Entra ID sign-in, checked on chat and dashboard routes so each
# user only sees their own conversations and pinned widgets. Use the same
# tenant id and SPA app (client) id as the frontend's VITE_AZURE_ENTRA_*.
AZURE_ENTRA_TENANT_ID=
AZURE_ENTRA_CLIENT_ID=

SECRET_KEY=change-me-in-production
